FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 37.5e5;

boundaryField
{
    fuel
    {
        type            zeroGradient;
    }

    LOX
    {
        type            zeroGradient;
    }

    outlet
    {
	    type 		    waveTransmissive;
	    gamma 		    1.4;
    }

    wall
    {
        type            zeroGradient;
    }

    front
    {
        type            cyclic;
    }

    back
    {
        type            cyclic;
    }
}

